{
  "expo": {
    "name": "Quiet DMs",
    "slug": "instagram-messenger",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1B2830"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.brade.instagrammessenger",
      "infoPlist": {
        "NSCameraUsageDescription": "Used to take photos and videos to send in your messages.",
        "NSMicrophoneUsageDescription": "Used to record voice notes and videos to send in your messages.",
        "NSPhotoLibraryUsageDescription": "Used to send photos and videos from your library in your messages.",
        "NSPhotoLibraryAddUsageDescription": "Used to save photos and videos from your messages.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1B2830"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "ca462d7a-482c-49b2-aa63-660d36812276"
      }
    }
  }
}
